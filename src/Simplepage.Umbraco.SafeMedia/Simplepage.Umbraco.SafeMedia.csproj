<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- wwwroot/App_Plugins ships as static web assets at the site root, where Umbraco looks for packages. -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Simplepage.Umbraco.SafeMedia</PackageId>
    <Version>1.2.1</Version>
    <Title>SafeMedia for Umbraco</Title>
    <Authors>Simplepage Ltd</Authors>
    <Company>Simplepage Ltd</Company>
    <Copyright>Copyright (c) 2026 Simplepage Ltd</Copyright>
    <Description>Refuses unsafe SVG and PDF uploads in Umbraco before they are stored. Parses rather than pattern matches, allowlists what is safe, and rejects rather than strips. Includes a health check for files already in the media library. Secure with zero configuration.</Description>
    <PackageTags>umbraco;umbraco-marketplace;umbraco-17;svg;pdf;security;xss;media;upload</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/SimplepageUK/safemedia</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SimplepageUK/safemedia</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Umbraco.Cms.Core" Version="[17.0.0, 18.0.0)" />
    <!-- PDF parsing for Pdf/. Apache-2.0, managed, no dependencies of its own. -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
